{
  "name": "yardmaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "yardmaster": "apps/server/dist/cli.js",
    "c-board": "apps/server/dist/c-board.js"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "pnpm --parallel --filter @yardmaster/server --filter @yardmaster/web dev",
    "dev:demo": "pnpm --parallel --filter @yardmaster/server --filter @yardmaster/web dev:demo",
    "yardmaster": "pnpm --silent --filter @yardmaster/server cli",
    "c-board": "pnpm --silent --filter @yardmaster/server cli:c-board",
    "board": "pnpm --filter \"@yardmaster/server...\" --filter @yardmaster/web build && node apps/server/dist/cli.js start --no-open",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "build": "pnpm -r build",
    "brand:build": "pnpm --filter @yardmaster/web brand:build",
    "check": "scripts/privacy-check.sh && pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @yardmaster/web build && playwright test -c e2e --project=e2e --project=e2e-webgl",
    "shots": "pnpm --filter @yardmaster/web build && playwright test -c e2e --project=shots",
    "motion:record": "pnpm --filter @yardmaster/web build && tsx e2e/motion/record.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26",
    "@types/ws": "^8.18.2",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "simple-git-hooks": {
    "pre-commit": "scripts/privacy-check.sh --staged && pnpm lint"
  },
  "pnpm": {
    "overrides": {
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "@azure/msal-node@<7.1.0": "^7.1.0"
    }
  }
}
