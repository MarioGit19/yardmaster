#!/bin/sh
# Yardmaster hook for Claude Code (PRD §6.1).
#
# Observer (async): forwards the hook payload on stdin to the local board, through the board's
# socket in the data dir (~/.yardmaster/board.sock), never TCP: a socket only this user owns
# can't be squatted by another local program the way a port can. It never writes to stdout
# (Claude Code could read that as a hook decision) and always exits 0.
#
# Away mode's PermissionRequest hook is yardmaster-hook-permission.mjs. A handler installed
# before it existed still runs this script with --permission: it gives no decision, so the
# terminal prompt appears, until `yardmaster hooks install` replaces it.

exec >/dev/null 2>&1

[ "${1:-}" = --permission ] && exit 0

# The old CBOARD_* names and ~/.c-board are read for one version (Yardmaster was c-board).
home="${YARDMASTER_HOME:-${CBOARD_HOME:-}}"
if [ -z "$home" ]; then
  home="$HOME/.yardmaster"
  # Until the server has started once and moved the old data dir here.
  [ -r "$home/token" ] || [ ! -r "$HOME/.c-board/token" ] || home="$HOME/.c-board"
fi
# A literal "~" in YARDMASTER_HOME is expanded here on purpose.
# shellcheck disable=SC2088
case "$home" in
  "~") home="$HOME" ;;
  "~/"*) home="$HOME/${home#\~/}" ;;
esac

# Only a socket this user owns, not a link to one: nobody else can create such a file.
sock="$home/board.sock"
[ -S "$sock" ] || exit 0
[ -n "$(find "$sock" -prune -type s -user "$(id -u)")" ] || exit 0

token=''
[ -r "$home/token" ] && IFS= read -r token <"$home/token"
token="${token%"${token##*[![:space:]]}"}"
case "$token" in
  '' | *[!A-Za-z0-9_-]*) exit 0 ;;
esac

command -v curl || exit 0

# The token goes in through a here-doc instead of argv so it doesn't show up in `ps`, and is
# still checked on the socket. -q skips ~/.curlrc; --noproxy keeps a proxy out of it.
curl -q -s --noproxy '*' --unix-socket "$sock" -m 1 -o /dev/null \
  -X POST \
  -H @/dev/fd/3 \
  -H 'Content-Type: application/json' \
  -H "X-Yardmaster-Claude-Pid: $PPID" \
  --data-binary @- \
  http://localhost/api/hooks/claude 3<<HEADERS
X-Yardmaster-Token: $token
HEADERS
exit 0
