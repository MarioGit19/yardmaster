{
  "name": "yardmaster-extension",
  "displayName": "Yardmaster",
  "description": "Mirrors this window's terminals to the local Yardmaster dashboard.",
  "version": "0.1.0",
  "private": true,
  "publisher": "yardmaster",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "dashboard",
    "claude"
  ],
  "icon": "media/icon.png",
  "main": "dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "yardmaster.openDashboard",
        "title": "Open Dashboard",
        "category": "Yardmaster"
      },
      {
        "command": "yardmaster.reconnect",
        "title": "Reconnect",
        "category": "Yardmaster"
      }
    ],
    "configuration": {
      "title": "Yardmaster",
      "properties": {
        "yardmaster.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Stream this window's terminals to the local Yardmaster server."
        },
        "yardmaster.port": {
          "type": "integer",
          "default": 4317,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port of the local Yardmaster server (it always listens on 127.0.0.1)."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "icon": "pnpm --filter @yardmaster/web exec tsx scripts/render-icons.ts --strict",
    "package": "node scripts/build.mjs --production && pnpm run icon && vsce package --no-dependencies --allow-missing-repository --skip-license --out dist/yardmaster.vsix",
    "test": "vitest run"
  },
  "dependencies": {
    "@yardmaster/protocol": "workspace:*",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "1.93.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  }
}
