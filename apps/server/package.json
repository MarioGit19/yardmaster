{
  "name": "@yardmaster/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "yardmaster": "./dist/cli.js",
    "c-board": "./dist/c-board.js"
  },
  "scripts": {
    "dev": "YARDMASTER_WATCH=1 YARDMASTER_DEV_ORIGINS=http://127.0.0.1:4327 tsx watch src/cli.ts start --no-open",
    "dev:demo": "YARDMASTER_WATCH=1 YARDMASTER_DEV_ORIGINS=http://127.0.0.1:4327 tsx watch src/cli.ts start --demo --no-open",
    "start": "node dist/cli.js start",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "cli:c-board": "tsx src/c-board.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308",
    "@yardmaster/hook": "workspace:*",
    "@yardmaster/protocol": "workspace:*",
    "@fastify/websocket": "^11.3.4",
    "chokidar": "^6.0.0",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
