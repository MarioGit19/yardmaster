{
  "name": "c-board",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "pnpm --parallel --filter @c-board/server --filter @c-board/web dev",
    "dev:demo": "pnpm --parallel --filter @c-board/server --filter @c-board/web dev:demo",
    "c-board": "pnpm --silent --filter @c-board/server cli",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "check": "scripts/privacy-check.sh && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "scripts/privacy-check.sh --staged && pnpm lint"
  }
}
