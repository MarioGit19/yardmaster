{
  "name": "@c-board/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "c-board": "./dist/cli.js"
  },
  "scripts": {
    "dev": "CBOARD_WATCH=1 CBOARD_DEV_ORIGINS=http://127.0.0.1:5173 tsx watch src/cli.ts start --no-open",
    "dev:demo": "CBOARD_WATCH=1 CBOARD_DEV_ORIGINS=http://127.0.0.1:5173 tsx watch src/cli.ts start --demo --no-open",
    "start": "node dist/cli.js start",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308",
    "@c-board/hook": "workspace:*",
    "@c-board/protocol": "workspace:*",
    "@fastify/websocket": "^11.3.4",
    "chokidar": "^6.0.0",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  }
}
